iv&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;font style=&quot;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;font style=&quot;font-weight: bold;&quot; color=&quot;#33ff33&quot;&gt;Fonte:&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(51, 255, 51); font-weight: 700; background-color: initial;&quot;&gt;Resolução CONAMA nº 432 de 13/07/2011&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;Arquivo:&amp;nbsp;&lt;font color=&quot;#ffb570&quot;&gt;\INPUT\&lt;/font&gt;Fatores_Deterioracao_Motos.xlsx&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#33FF33;" parent="1" vertex="1">
