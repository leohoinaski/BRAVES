        <mxCell id="NN52Et9S-NWGV-sPvVk5-5" value="EQUAÇÃO:&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(204, 0, 204); background-color: initial;&quot;&gt;FUELTYPE_ComLEVES83&amp;nbsp;&lt;/span&gt;= VeiculosTipoCombustivel(x) / SomaTiposdeCombustivel&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;font color=&quot;#cc00cc&quot;&gt;FUELTYPE_ComLEVES2003&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;= VeiculosTipoCombustivel(x) / SomaTiposdeCombustivel&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;font color=&quot;#cc00cc&quot;&gt;FUELTYPE_ComLEVES2006&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;= VeiculosTipoCombustivel(x) / SomaTiposdeCombustivel&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;font color=&quot;#cc00cc&quot;&gt;FUELTYPE_ComLEVES2007&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;= VeiculosTipoCombustivel(x) / SomaTiposdeCombustivel&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;" vertex="1" parent="1">
