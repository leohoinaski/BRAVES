        <mxCell id="DUTUmIXobXM5Z29R_gFR-1" value="Scripts para adequar os dados de entrada:&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;font color=&quot;#3333ff&quot;&gt;Indentify_CODE_IBGE.m&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;font color=&quot;#3333ff&quot;&gt;prep_ConsumoComb.m &lt;/font&gt;(Etanol, Gasolina C e Diesel)&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;font color=&quot;#3333ff&quot;&gt;AddIBGEdata_ConsumoComb.m&amp;nbsp;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;(Etanol, Gasolina C e Diesel)&lt;/span&gt;&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;font color=&quot;#3333ff&quot;&gt;prep_YEARMOD.m&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;font color=&quot;#3333ff&quot;&gt;AddIBGEdata_FROTADATA.m&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;font color=&quot;#3333ff&quot;&gt;prep_FUELTYPE.m&lt;br&gt;&lt;/font&gt;&lt;/li&gt;&lt;li style=&quot;text-align: left;&quot;&gt;&lt;font color=&quot;#3333ff&quot;&gt;prep_veicCATEGORY.m&lt;/font&gt;&lt;br&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font color=&quot;#cc00cc&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font color=&quot;#cc00cc&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Outputs:&lt;/span&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font color=&quot;#cc00cc&quot;&gt;- Matriz de consumo de Etanol por município (ConsumoETANOL)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font color=&quot;#cc00cc&quot;&gt;- Matriz de consumo de Gasolina C por município (ConsumoGASOLINA)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font color=&quot;#cc00cc&quot;&gt;- Matriz de consumo de Diesel por município (ConsumoDIESEL)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font color=&quot;#cc00cc&quot;&gt;- Matriz de ano modelo por município (YEARMOD)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font color=&quot;#cc00cc&quot;&gt;- Matriz de categorias de veículo por município (veicCATEGORY)&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font color=&quot;#cc00cc&quot;&gt;- Matriz de tipo de combustível por município (FUELTYPE)&lt;/font&gt;&lt;/div&gt;" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;strokeColor=#3333FF;" vertex="1" parent="1">
          <mxGeometry x="162.5" y="460" width="550" height="300" as="geometry" />
        </mxCell>
        <mxCell id="DUTUmIXobXM5Z29R_gFR-4" value="&lt;font color=&quot;#ff3333&quot;&gt;&lt;b&gt;CombustívelTransportes_BEN.m&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Esta função importa a proporção de combustível (Diesel, Etanol e Gasolina C) produzido no país que é destinado ao transporte Rodoviário, e multiplica pelo consumo de combustível da ANP.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Esses dados devem ser disponibilizados pelo usuário em um arquivo (.xlsx:) para ser reconhecido pela função.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font color=&quot;#33ff33&quot;&gt;Fonte:&amp;nbsp;&lt;span style=&quot;background-color: initial;&quot;&gt;BEN - Balanço Energético Nacional&lt;/span&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Arquivo:&amp;nbsp;&lt;font color=&quot;#ffb570&quot;&gt;\INPUT\&lt;/font&gt;ConsumoCombustiveTransporte_BEN.xlsx&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#cc00cc&quot;&gt;OUTPUT:&lt;/font&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(204, 0, 204); text-align: left;&quot;&gt;ConsumoETANOL&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(204, 0, 204); text-align: left;&quot;&gt;ConsumoGASOLINA&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(204, 0, 204); text-align: left;&quot;&gt;ConsumoDIESEL&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#FF3333;" vertex="1" parent="1">
          <mxGeometry x="-790" y="990" width="373.75" height="350" as="geometry" />
        </mxCell>
